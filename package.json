{
  "name": "@civilization/deepseek-genui",
  "version": "1.0.0",
  "description": "Enterprise-ready GenUI panel bundle for DeepSeek Harness with 7-dimensional component system, offline Mermaid/ReactFlow, and host fault isolation.",
  "type": "module",
  "main": "index.js",
  "author": "civilization-os",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civilization-os/deepseek-harness-genui.git"
  },
  "homepage": "https://github.com/civilization-os/deepseek-harness-genui#readme",
  "bugs": {
    "url": "https://github.com/civilization-os/deepseek-harness-genui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "genui",
    "generative-ui",
    "mermaid",
    "reactflow",
    "agent-ui",
    "data-visualization"
  ],
  "scripts": {
    "verify": "node --check client.js && node --check index.js",
    "test": "node --check client.js && node --check index.js",
    "pack": "npm pack"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "skills/**",
    "agent-genui-system-design.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
